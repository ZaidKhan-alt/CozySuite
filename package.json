{
  "name": "cozy-office",
  "version": "1.0.0",
  "description": "Cozy Office Desktop App",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:start": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cozyoffice.app",
    "productName": "Cozy Office",
    "directories": {
      "output": "C:/Users/ZAID KHAN/Desktop/CozyOffice-Installer"
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Document",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "Presentation",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "highlight.js": "^11.12.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.18.9",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "quill": "^2.0.3",
    "quill-blot-formatter": "^1.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "x-data-spreadsheet": "^1.1.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "less": "^4.9.1"
  }
}
